# -----------------------------------------------------------------------------
# Lorro Launcher environment variables
# -----------------------------------------------------------------------------
# Larro reuses the upstream Hydra backend for its cloud features (accounts,
# catalogue, download sources, reviews, cloud saves). These are the official
# production endpoints documented for the upstream project. Without them the
# launcher starts but login, catalogue and sources will NOT work.
#
# You can point these to your own compatible backend instead.

MAIN_VITE_API_URL=https://hydra-api-us-east-1.losbroxas.org
MAIN_VITE_AUTH_URL=https://auth.hydralauncher.gg
MAIN_VITE_CHECKOUT_URL=https://checkout.hydralauncher.gg
MAIN_VITE_EXTERNAL_RESOURCES_URL=https://assets.hydralauncher.gg
RENDERER_VITE_EXTERNAL_RESOURCES_URL=https://assets.hydralauncher.gg

# Referral codes used by the download integrations (optional).
RENDERER_VITE_REAL_DEBRID_REFERRAL_ID=
RENDERER_VITE_TORBOX_REFERRAL_CODE=

# Remote renderer bundle (leave empty to always use the local bundled UI).
MAIN_VITE_LAUNCHER_SUBDOMAIN=

# -----------------------------------------------------------------------------
# Lorro Launcher distribution configuration
# -----------------------------------------------------------------------------
# Set to owner/repo to enable GitHub auto-updates for Lorro releases.
MAIN_VITE_UPDATE_REPOSITORY=
# Public URL where users can download new Lorro releases.
RENDERER_VITE_RELEASES_URL=
# Optional: override Lorro user data directory in development.
MAIN_VITE_USER_DATA_PATH=
